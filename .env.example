# =============================================================================
# Turon Avto Test | UZ — environment configuration
# Copy this file to `.env` and fill in the real values. Never commit `.env`.
# =============================================================================

# --- Telegram -----------------------------------------------------------------
# Token issued by @BotFather.
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed into the admin panel.
# Find yours by messaging @userinfobot.
ADMIN_IDS=123456789,987654321

# --- Database -----------------------------------------------------------------
# Async SQLAlchemy DSN. Inside Docker Compose the host is the `postgres` service.
DATABASE_URL=postgresql+asyncpg://turon:turon@postgres:5432/turon_avto

# Credentials consumed by the `postgres` container in docker-compose.yml.
POSTGRES_USER=turon
POSTGRES_PASSWORD=turon
POSTGRES_DB=turon_avto

# --- Scheduling ---------------------------------------------------------------
# All schedule times are interpreted in this timezone, never in server local time.
TIMEZONE=Asia/Tashkent

# Grace period (seconds) for a job that fired while the bot was down.
# A missed run older than this is skipped rather than fired late.
SCHEDULER_MISFIRE_GRACE=3600

# --- Content ------------------------------------------------------------------
# Default interface language for new users: uz | ru
DEFAULT_LANGUAGE=uz

# Where downloaded question images are cached on disk.
MEDIA_ROOT=media/images

# Send images as uncompressed documents to preserve quality.
# false = normal photo (compressed by Telegram, but renders inline).
SEND_IMAGES_AS_DOCUMENT=false

# --- Reliability --------------------------------------------------------------
# Attempts for network operations (imports, media downloads, Telegram sends).
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0

# Notify every admin in ADMIN_IDS when an unhandled error occurs.
NOTIFY_ADMINS_ON_ERROR=true

# --- Logging ------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
# text | json
LOG_FORMAT=text

# --- Backups ------------------------------------------------------------------
BACKUP_DIR=backups
